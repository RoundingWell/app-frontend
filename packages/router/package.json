{
  "private": true,
  "name": "@mnjs/router",
  "description": "Named, nested routes over the Navigation API and URLPattern",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./outlet": "./outlet.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "outlet.js",
    "src/",
    "readme.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:browser": "playwright test"
  },
  "keywords": [
    "marionette",
    "router",
    "routing",
    "navigation-api",
    "urlpattern"
  ],
  "license": "MIT",
  "dependencies": {
    "@mnjs/utils": "5.0.0"
  },
  "peerDependencies": {
    "marionette": "5.0.0"
  },
  "peerDependenciesMeta": {
    "marionette": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
