{
  "private": true,
  "name": "app-frontend",
  "version": "1.0.0",
  "description": "Frontend Assets for RoundingWell Care Team Operations",
  "repository": "git@github.com:RoundingWell/app-frontend.git",
  "author": "RoundingWell",
  "license": "CC-BY-4.0",
  "homepage": "https://RoundingWell.com",
  "type": "module",
  "workspaces": [
    "packages/care-ops-auth",
    "packages/care-ops-config",
    "packages/care-ops-datadog",
    "packages/care-ops-five9",
    "packages/care-ops-fontawesome",
    "packages/care-ops-quicksight",
    "packages/care-ops-ringcentral"
  ],
  "scripts": {
    "analyze": "npx vite-bundle-visualizer",
    "prebuild:shared-runtime": "rimraf public/shared",
    "build:shared:config": "vite build --config vite.shared.config.js --mode shared-config",
    "build:shared:datadog": "vite build --config vite.shared.config.js --mode shared-datadog",
    "build:shared:forms": "vite build --config vite.shared.config.js --mode shared-forms",
    "build:shared-runtime": "npm run build:shared:config && npm run build:shared:datadog && npm run build:shared:forms",
    "build": "vite build",
    "prebuild": "npm run build:shared-runtime",
    "deploy": "node scripts/deploy.js",
    "artifact:publish": "node scripts/publish-artifact.js",
    "artifact:download": "node scripts/download-artifact.js",
    "predeploy:dev": "npm run build",
    "deploy:dev": "node --env-file=.env scripts/deploy.js",
    "predeploy:qa": "npm run build",
    "deploy:qa": "node --env-file=.env scripts/deploy.js --stage=qa --organization=quality-assurance",
    "predeploy:qa2": "npm run build",
    "deploy:qa2": "node --env-file=.env scripts/deploy.js --stage=qa --organization=qa2",
    "coverage": "npm run coverage:clear && npm run coverage:component && npm run coverage:e2e && npm stop",
    "precoverage:e2e": "npm run build -- --mode test",
    "coverage:e2e": "vite preview -m test & VITE_PID=$!; cypress run; status=$?; kill $VITE_PID 2>/dev/null; exit $status",
    "postcoverage:e2e": "npm run coverage:report",
    "coverage:component": "cypress run --component",
    "postcoverage:component": "npm run coverage:report",
    "coverage:clear": "rimraf .nyc_output coverage",
    "coverage:report": "nyc report --reporter=html --reporter=text",
    "coverage:report:ci": "nyc report --reporter=lcovonly",
    "dev": "vite -d",
    "test": "vite -m test & cypress open",
    "lint": "npm run eslint && npm run stylelint && npm run editorconfig",
    "lint:fix": "npm run eslint:fix && npm run stylelint:fix",
    "eslint": "eslint src/js test --max-warnings=0",
    "eslint:fix": "eslint --fix src/js/ && eslint --fix test/",
    "stylelint": "stylelint --max-warnings=0 \"src/**/*.scss\"",
    "stylelint:fix": "stylelint --fix \"src/**/*.scss\"",
    "editorconfig": "editorconfig-checker",
    "release": "node ./scripts/release.js",
    "release:dry-run": "node ./scripts/release.js --dry-run",
    "prestart": "npm run build",
    "start": "vite preview",
    "stop": "pkill -f vite || true && rimraf node_modules/.vite"
  },
  "browserslist": [
    ">1%",
    "not op_mini all"
  ],
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.986.0",
    "@aws-sdk/client-cloudfront": "^3.985.0",
    "@aws-sdk/client-s3": "^3.984.0",
    "@aws-sdk/client-secrets-manager": "^3.982.0",
    "@aws-sdk/credential-providers": "^3.983.0",
    "@babel/core": "^7.27.4",
    "@cypress/code-coverage": "^4.0.0",
    "@cypress/mount-utils": "^4.0.0",
    "@cypress/vite-dev-server": "^7.0.0",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.0.0",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/core": "^7.0.6",
    "@rollup/plugin-babel": "^7.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@roundingwell/care-ops-fontawesome": "workspace:*",
    "@stylistic/eslint-plugin": "^5.3.1",
    "babel-plugin-istanbul": "^8.0.0",
    "browserslist-to-esbuild": "^2.1.1",
    "cypress": "^15.0.0",
    "cypress-vite": "^1.5.0",
    "editorconfig-checker": "^6.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.0.1",
    "eslint-plugin-chai-friendly": "^1.0.0",
    "eslint-plugin-cypress": "^6.1.0",
    "eslint-plugin-mocha": "^11.0.0",
    "fs-extra": "^11.1.1",
    "globals": "^17.0.0",
    "istanbul-lib-coverage": "^3.0.2",
    "js-yaml": "^4.1.0",
    "magic-string": "^0.30.17",
    "mock-socket": "^9.3.1",
    "nyc": "^18.0.0",
    "postcss": "^8.5.13",
    "rimraf": "^6.0.1",
    "sass": "^1.42.1",
    "shelljs": "^0.10.0",
    "stylelint": "^17.3.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.0.0",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.0.0",
    "workbox-cacheable-response": "^7.3.0",
    "workbox-core": "^7.3.0",
    "workbox-navigation-preload": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0",
    "workbox-window": "^7.3.0",
    "yaml": "^2.1.1"
  },
  "dependencies": {
    "@formatjs/intl": "^4.1.8",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@roundingwell/care-ops-auth": "workspace:*",
    "@roundingwell/care-ops-config": "workspace:*",
    "@roundingwell/care-ops-datadog": "workspace:*",
    "@roundingwell/care-ops-five9": "workspace:*",
    "@roundingwell/care-ops-quicksight": "workspace:*",
    "@roundingwell/care-ops-ringcentral": "workspace:*",
    "animejs": "^4.1.3",
    "backbone": "^1.4.0",
    "backbone.eventrouter": "^1.0.1",
    "backbone.marionette": "^4.1.2",
    "backbone.radio": "^2.0.0",
    "backbone.store": "^2.0.0",
    "dayjs": "^1.10.6",
    "handlebars": "^4.7.9",
    "idb": "^7.1.1",
    "jquery": "^4.0.0",
    "libphonenumber-js": "^1.10.38",
    "marionette.toolkit": "^6.2.0",
    "sortablejs": "^1.14.0",
    "underscore": "^1.13.1",
    "uuid": "^14.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.50.0"
  }
}
