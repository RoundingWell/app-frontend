<span class="messaging-composer__marker" aria-hidden="true">{{far "paper-plane-top"}}</span>
<div class="messaging-composer__box">
  <div class="messaging-composer__header">
    <strong>{{ @intl.patients.shared.messaging.composerView.heading }}</strong>
    {{#if phone}}<span>{{ @intl.patients.shared.messaging.composerView.to }} <strong>{{ patientName }}</strong> {{formatPhoneNumber phone}}</span>{{/if}}
  </div>
  <div class="messaging-composer__field textarea-flex">
    <textarea class="textarea-flex__input messaging-composer__input js-input" placeholder="{{#if phone}}{{formatMessage (intlGet "patients.shared.messaging.composerView.placeholder") name=firstName}}{{else}}{{formatMessage (intlGet "patients.shared.messaging.composerView.noMobile") name=firstName}}{{/if}}" aria-label="{{ @intl.patients.shared.messaging.composerView.heading }}" {{#unless phone}}disabled{{/unless}}></textarea>
    <div class="textarea-flex__mirror messaging-composer__input js-spacer" aria-hidden="true">{{ body }} </div>
  </div>
  <div class="messaging-composer__footer">
    <button class="button button--positive messaging-composer__send js-send" type="button" {{#unless canSend}}disabled{{/unless}}>{{far "paper-plane-top"}}<span>{{ @intl.patients.shared.messaging.composerView.send }}</span></button>
  </div>
</div>
