<span class="patient-interactions__marker" aria-hidden="true">{{far icon}}</span>
<div class="patient-interactions__activity-body">
  <div class="patient-interactions__activity-line">
    <span class="patient-interactions__activity-description">
      {{#if description.name}}<strong>{{ description.name }}</strong>{{/if}}{{#if description.text}} {{ description.text }}{{/if}}
      <span class="patient-interactions__time{{#if (isValue group "appointments")}} patient-interactions__time--appointment{{/if}}">
        {{#if viaLabel}}{{ viaLabel }}{{/if}}{{#if timestamp}}{{#if timeSeparator}} • {{/if}}<time datetime="{{ timestamp }}">{{formatDateTime timeDate timeFormat}}{{#if appointmentTimezone}} {{ appointmentTimezone }}{{/if}}</time>{{/if}}
      </span>
    </span>
    {{#if activity}}<button class="patient-interactions__action js-interaction" type="button">{{ @intl.patients.shared.interactions.interactionItemView.viewOnInteractions }} {{far "angle-right"}}</button>{{else if workName}}<button class="patient-interactions__action js-action" type="button">{{ workName }} {{far "angle-right"}}</button>{{/if}}
  </div>
  {{#if hasCardContent}}<div class="patient-interactions__card">
    {{#if (isValue group "appointments")}}
      {{#if metadata.appointment_type}}<div class="patient-interactions__item-heading"><span class="patient-interactions__appointment-type">{{ metadata.appointment_type }}</span></div>{{/if}}
      {{#if appointmentDate}}
        <p class="patient-interactions__detail">{{formatDateTime appointmentDate "DATE"}} {{ @intl.patients.shared.interactions.interactionItemView.appointmentAt }} {{formatDateTime appointmentDate "TIME"}}{{#if appointmentTimezone}} {{ appointmentTimezone }}{{/if}}{{#if hasDuration}} • {{formatMessage @intl.patients.shared.interactions.interactionItemView.appointmentDuration minutes=metadata.duration_minutes}}{{/if}}</p>
      {{else if hasDuration}}
        <p class="patient-interactions__detail">{{formatMessage @intl.patients.shared.interactions.interactionItemView.appointmentDuration minutes=metadata.duration_minutes}}</p>
      {{/if}}
      {{#if metadata.provider}}
        <p class="patient-interactions__detail">{{ @intl.patients.shared.interactions.interactionItemView.appointmentWith }} {{ metadata.provider }}{{#if metadata.department}} {{ @intl.patients.shared.interactions.interactionItemView.appointmentAt }} {{ metadata.department }}{{/if}}</p>
      {{else if metadata.department}}
        <p class="patient-interactions__detail">{{ @intl.patients.shared.interactions.interactionItemView.appointmentAtStart }} {{ metadata.department }}</p>
      {{/if}}
      {{#if (isValue appointmentStatus "cancelled")}}<p class="patient-interactions__detail patient-interactions__cancellation">{{ @intl.patients.shared.interactions.interactionItemView.appointmentCancelled }}{{#if metadata.cancel_reason}}: {{ metadata.cancel_reason }}{{/if}}</p>{{/if}}
    {{else if (isValue group "visits")}}
      {{#if hasVisitHeading}}<div class="patient-interactions__item-heading">{{#if patientClass}}<span class="patient-interactions__channel">{{ patientClass }}</span>{{#if metadata.facility}}<span class="patient-interactions__separator">•</span><span>{{ metadata.facility }}</span>{{/if}}{{else}}{{ metadata.facility }}{{/if}}</div>{{/if}}
      {{#if metadata.admitted_at}}
        <p class="patient-interactions__detail">{{ @intl.patients.shared.interactions.interactionItemView.admitted }} {{formatDateTime metadata.admitted_at "DATE"}} {{ @intl.patients.shared.interactions.interactionItemView.appointmentAt }} {{formatDateTime metadata.admitted_at "TIME"}}{{#if metadata.admit_reason}} • {{ metadata.admit_reason }}{{/if}}</p>
      {{else if metadata.admit_reason}}
        <p class="patient-interactions__detail">{{ metadata.admit_reason }}</p>
      {{/if}}
      {{#if metadata.discharged_at}}
        <p class="patient-interactions__detail">{{ @intl.patients.shared.interactions.interactionItemView.discharged }} {{formatDateTime metadata.discharged_at "DATE"}} {{ @intl.patients.shared.interactions.interactionItemView.appointmentAt }} {{formatDateTime metadata.discharged_at "TIME"}}{{#if metadata.discharge_disposition}} • {{ metadata.discharge_disposition }}{{/if}}</p>
      {{else if metadata.admitted_at}}
        <p class="patient-interactions__detail"><em>{{ @intl.patients.shared.interactions.interactionItemView.noDischarge }}</em></p>
      {{/if}}
    {{else if (isValue group "calls")}}
      <div class="patient-interactions__item-heading"><span class="patient-interactions__channel">{{#if (isValue direction "inbound")}}{{ @intl.patients.shared.interactions.interactionItemView.inbound }}{{else}}{{ @intl.patients.shared.interactions.interactionItemView.outbound }}{{/if}} {{ channelLabel }}</span>{{#if metadata.disposition}}<span class="patient-interactions__separator">•</span><span>{{ metadata.disposition }}</span>{{/if}}</div>
    {{/if}}
    {{#if summary}}<p class="patient-interactions__summary">{{ summary }}</p>{{/if}}
  </div>{{/if}}
</div>
