<span class="patient-interactions__marker" aria-hidden="true">{{far icon}}</span>
<div class="patient-interactions__activity-body">
  <div class="patient-interactions__activity-line">
    <span class="patient-interactions__activity-description">
      {{#if (isValue group "appointments")}}<strong>{{ @intl.patients.shared.interactions.interactionItemView.appointment }}</strong>
      {{else}}{{#if (isValue group "visits")}}<strong>{{ @intl.patients.shared.interactions.interactionItemView.visit }}</strong> {{ @intl.patients.shared.interactions.interactionItemView.added }}
      {{else}}{{#if (isValue group "messages")}}{{#if (isValue direction "inbound")}}{{#if metadata.from}}<strong>{{ metadata.from }}</strong>{{else}}{{ @intl.patients.shared.interactions.interactionItemView.inbound }} {{ @intl.patients.shared.interactions.interactionItemView.message }}{{/if}}{{else}}{{#if metadata.clinician_name}}<strong>{{ metadata.clinician_name }}</strong>{{/if}}{{/if}}
      {{else}}{{#if metadata.clinician_name}}<strong>{{ metadata.clinician_name }}</strong> {{/if}}{{ @intl.patients.shared.interactions.interactionItemView.loggedCall }}{{/if}}{{/if}}{{/if}}
      <span class="patient-interactions__time">
        {{#if (isValue group "visits")}}{{#if metadata.source}}{{ @intl.patients.shared.interactions.interactionItemView.via }} {{ metadata.source }}{{#if timestamp}} • {{/if}}{{/if}}<time datetime="{{ timestamp }}">{{formatDateTime timestamp timeFormat}}</time>
        {{else}}{{#if viaLabel}}{{ viaLabel }}{{#if timestamp}} • {{/if}}{{/if}}<time datetime="{{ timestamp }}">{{#if (isValue group "appointments")}}{{formatDateTime appointmentDate timeFormat}}{{#if appointmentTimezone}} {{ appointmentTimezone }}{{/if}}{{else}}{{formatDateTime timestamp timeFormat}}{{/if}}</time>{{/if}}
      </span>
    </span>
    {{#if activity}}<button class="patient-interactions__action js-interaction" type="button">{{ @intl.patients.shared.interactions.interactionItemView.viewOnInteractions }} {{far "angle-right"}}</button>{{else}}{{#if workName}}<button class="patient-interactions__action js-action" type="button">{{ workName }} {{far "angle-right"}}</button>{{/if}}{{/if}}
  </div>
  <div class="patient-interactions__card">
    {{#if (isValue group "appointments")}}
      <div class="patient-interactions__item-heading">
        {{#if metadata.appointment_type}}<span class="patient-interactions__appointment-type">{{ metadata.appointment_type }}</span>{{#if (lookup @intl.patients.shared.interactions.interactionItemView.appointmentStatuses appointmentStatus)}}<span class="patient-interactions__separator">•</span>{{/if}}{{/if}}<span>{{lookup @intl.patients.shared.interactions.interactionItemView.appointmentStatuses appointmentStatus}}</span>
      </div>
      {{#if appointmentDate}}<p class="patient-interactions__detail">{{formatDateTime appointmentDate "DATE"}} {{ @intl.patients.shared.interactions.interactionItemView.appointmentAt }} {{formatDateTime appointmentDate "TIME"}}{{#if appointmentTimezone}} {{ appointmentTimezone }}{{/if}}{{#if hasDuration}} • {{formatMessage @intl.patients.shared.interactions.interactionItemView.appointmentDuration minutes=metadata.duration_minutes}}{{/if}}</p>{{else}}{{#if hasDuration}}<p class="patient-interactions__detail">{{formatMessage @intl.patients.shared.interactions.interactionItemView.appointmentDuration minutes=metadata.duration_minutes}}</p>{{/if}}{{/if}}
      {{#if metadata.provider}}<p class="patient-interactions__detail">{{ @intl.patients.shared.interactions.interactionItemView.appointmentWith }} {{ metadata.provider }}{{#if metadata.department}} {{ @intl.patients.shared.interactions.interactionItemView.appointmentAt }} {{ metadata.department }}{{/if}}</p>{{else}}{{#if metadata.department}}<p class="patient-interactions__detail">{{ @intl.patients.shared.interactions.interactionItemView.appointmentAtStart }} {{ metadata.department }}</p>{{/if}}{{/if}}
      {{#if (isValue appointmentStatus "cancelled")}}<p class="patient-interactions__detail patient-interactions__cancellation">{{ @intl.patients.shared.interactions.interactionItemView.appointmentCancelled }}{{#if metadata.cancel_reason}}: {{ metadata.cancel_reason }}{{/if}}</p>{{/if}}
    {{else}}{{#if (isValue group "visits")}}
      {{#if patientClass}}<div class="patient-interactions__item-heading"><span class="patient-interactions__channel">{{ patientClass }}</span>{{#if metadata.facility}}<span class="patient-interactions__separator">•</span><span>{{ metadata.facility }}</span>{{/if}}</div>{{else}}{{#if metadata.facility}}<div class="patient-interactions__item-heading">{{ metadata.facility }}</div>{{/if}}{{/if}}
      {{#if metadata.admitted_at}}<p class="patient-interactions__detail">{{ @intl.patients.shared.interactions.interactionItemView.admitted }} {{formatDateTime metadata.admitted_at "MMM D [at] h:mm A"}}{{#if metadata.admit_reason}} • {{ metadata.admit_reason }}{{/if}}</p>{{else}}{{#if metadata.admit_reason}}<p class="patient-interactions__detail">{{ metadata.admit_reason }}</p>{{/if}}{{/if}}
      {{#if metadata.discharged_at}}<p class="patient-interactions__detail">{{ @intl.patients.shared.interactions.interactionItemView.discharged }} {{formatDateTime metadata.discharged_at "MMM D [at] h:mm A"}}{{#if hasStay}} • {{formatMessage @intl.patients.shared.interactions.interactionItemView.lengthOfStay days=stayDays}}{{/if}}{{#if metadata.discharge_disposition}} • {{ metadata.discharge_disposition }}{{/if}}</p>{{else}}{{#if metadata.admitted_at}}<p class="patient-interactions__detail"><em>{{ @intl.patients.shared.interactions.interactionItemView.noDischarge }}</em>{{#if hasStay}} • {{formatMessage @intl.patients.shared.interactions.interactionItemView.lengthOfStay days=stayDays}}{{/if}}</p>{{/if}}{{/if}}
      {{#if metadata.note}}<p class="patient-interactions__summary">{{ metadata.note }}</p>{{/if}}
    {{else}}{{#if (isValue group "calls")}}
      <div class="patient-interactions__item-heading"><span class="patient-interactions__channel">{{#if (isValue direction "inbound")}}{{ @intl.patients.shared.interactions.interactionItemView.inbound }}{{else}}{{ @intl.patients.shared.interactions.interactionItemView.outbound }}{{/if}} {{ channelLabel }}</span>{{#if metadata.disposition}}<span class="patient-interactions__separator">•</span><span>{{ metadata.disposition }}</span>{{/if}}</div>
      {{#if metadata.note}}<p class="patient-interactions__summary">{{ metadata.note }}</p>{{/if}}
    {{else}}{{#if (isValue channel "sms")}}{{#if (isValue direction "inbound")}}{{#if metadata.body}}<p class="patient-interactions__summary">{{ metadata.body }}</p>{{else}}{{#if metadata.note}}<p class="patient-interactions__summary">{{ metadata.note }}</p>{{/if}}{{/if}}{{else}}{{#if metadata.message}}<p class="patient-interactions__summary">{{ metadata.message }}</p>{{else}}{{#if metadata.note}}<p class="patient-interactions__summary">{{ metadata.note }}</p>{{/if}}{{/if}}{{/if}}{{else}}{{#if metadata.note}}<p class="patient-interactions__summary">{{ metadata.note }}</p>{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}
  </div>
</div>
