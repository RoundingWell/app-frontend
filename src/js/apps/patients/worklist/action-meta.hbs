<span class="work-card__timestamps">
  <span>{{ @intl.patients.worklist.actionViews.added }} {{formatDateTime created_at "TIME_OR_DAY"}}&#8203;</span>
  <span>{{ @intl.patients.worklist.actionViews.updated }} {{formatDateTime updated_at "TIME_OR_DAY"}}&#8203;</span>
</span>
{{#if attachmentCount}}<span class="action-card__counts js-no-click">
  <button class="action-card__count js-attachments" type="button" aria-label="{{formatMessage (intlGet "patients.shared.attachmentsLabel") itemCount=attachmentCount}}">{{far "paperclip"}}<span> {{ attachmentCount }}</span></button>
  {{#if commentCount}}<button class="action-card__count js-comments" type="button" aria-label="{{formatMessage (intlGet "patients.schedule.scheduleViews.dayItemView.commentsLabel") itemCount=commentCount}}">{{far "comment"}}<span> {{ commentCount }}</span></button>{{/if}}
</span>{{else}}{{#if commentCount}}<span class="action-card__counts js-no-click">
  <button class="action-card__count js-comments" type="button" aria-label="{{formatMessage (intlGet "patients.schedule.scheduleViews.dayItemView.commentsLabel") itemCount=commentCount}}">{{far "comment"}}<span> {{ commentCount }}</span></button>
</span>{{/if}}{{/if}}
