<div class="worklist-list__check js-no-click"><span data-check-region></span></div>
<div class="work-card__surface">
  <div class="work-card__main">
    <div class="work-card__heading">
      <span class="work-card__state patient-list__state worklist-list__state js-no-click" data-state-region></span>
      <div class="work-card__copy">
        <div class="work-card__title-row">
          <button class="work-card__subject patient-list__patient patient-list__patient--primary worklist-list__patient worklist-list__patient--action js-patient" type="button" aria-expanded="false" aria-controls="worklist-list-sidebar">{{ patient.first_name }} {{ patient.last_name }}</button>
          <span class="work-card__separator">·</span>
          <button class="work-card__title js-primary" type="button">{{ name }}&#8203;</button>
          <span class="action-card__tool worklist-list__action-tool js-no-click"><span data-details-region></span></span>
          <span class="action-card__tool worklist-list__action-tool js-no-click"><span data-form-region></span></span>
        </div>
        {{#if flowName}}
        <div class="work-card__context">
          <span class="worklist-list__patient-context worklist-list__patient-context--action">
            <button class="worklist-list__flow-context js-flow" type="button">{{ flowName }}</button>{{#if patient.segment}} · {{/if}}{{#if patient.segment}}<span class="worklist-list__underline">{{ patient.segment }}</span>{{/if}}&#8203;
          </span>
        </div>
        {{else}}{{#if patient.segment}}
        <div class="work-card__context">
          <span class="worklist-list__patient-context worklist-list__patient-context--action"><span class="worklist-list__underline">{{ patient.segment }}</span>&#8203;</span>
        </div>
        {{/if}}{{/if}}
      </div>
    </div>
  </div>
  <div class="work-card__aside">
    <div class="work-card__controls action-card__controls worklist-list__chips worklist-list__chips--action">
      <span class="work-card__control worklist-list__search-helper">&#8203;{{ state }}&#8203;</span>
      <span class="work-card__control action-card__owner js-no-click"><span data-owner-region></span><span class="worklist-list__search-helper">&#8203;{{ owner }}&#8203;</span></span>
      <span class="work-card__control button-group action-card__due worklist-list__end-control js-no-click"><span data-due-date-region></span>{{~ remove_whitespace ~}}<span data-due-time-region></span></span>
    </div>
    <div class="work-card__meta action-card__meta">
      <span class="work-card__timestamps">
        <span>{{ @intl.patients.worklist.actionViews.added }} {{formatDateTime created_at "TIME_OR_DAY"}}&#8203;</span>
        <span>{{ @intl.patients.worklist.actionViews.updated }} {{formatDateTime updated_at "TIME_OR_DAY"}}&#8203;</span>
      </span>
      {{#if attachmentCount}}<span class="action-card__counts">
        <span class="action-card__count" role="img" aria-label="{{formatMessage (intlGet "patients.shared.attachmentsLabel") itemCount=attachmentCount}}">{{far "paperclip"}}<span> {{ attachmentCount }}</span></span>
        {{#if commentCount}}<span class="action-card__count" role="img" aria-label="{{formatMessage (intlGet "patients.schedule.scheduleViews.dayItemView.commentsLabel") itemCount=commentCount}}">{{far "comment"}}<span> {{ commentCount }}</span></span>{{/if}}
      </span>{{else}}{{#if commentCount}}<span class="action-card__counts">
        <span class="action-card__count" role="img" aria-label="{{formatMessage (intlGet "patients.schedule.scheduleViews.dayItemView.commentsLabel") itemCount=commentCount}}">{{far "comment"}}<span> {{ commentCount }}</span></span>
      </span>{{/if}}{{/if}}
    </div>
  </div>
</div>
