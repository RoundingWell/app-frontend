<div class="worklist-list__check js-no-click"><span data-check-region></span></div>
<div class="work-card__surface js-action-surface">
  <div class="work-card__main">
    <div class="work-card__heading">
      <span class="work-card__state patient-list__state worklist-list__state js-no-click" data-state-region></span>
      <div data-copy-region></div>
    </div>
  </div>
  <div class="work-card__aside">
    <div class="work-card__controls action-card__controls worklist-list__chips worklist-list__chips--action">
      <span class="work-card__control action-card__owner"><span data-owner-region></span></span>
      <span class="work-card__control button-group button-group--joined action-card__due worklist-list__end-control"><span data-due-date-region></span>{{~ remove_whitespace ~}}<span data-due-time-region></span></span>
    </div>
    <div data-meta-region></div>
  </div>
</div>
