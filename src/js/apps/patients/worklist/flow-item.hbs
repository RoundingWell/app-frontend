<div class="table-list__item-check js-no-click"><span data-check-region></span></div>
<div>
  <button class="button-secondary--compact js-patient-sidebar-button">
    {{far "address-card"}}&#8203;
  </button>
</div>
<div class="js-patient">
  {{#if patient.segment}}<div class="u-text--overflow-two-lines worklist-list__overline">{{ patient.segment }}&#8203;</div>{{/if}}
  <span class="u-text--overflow-two-lines worklist-list__patient-name">{{ patient.first_name }} {{ patient.last_name }}&#8203;</span>
</div>
<div class="worklist-list__flow-icon">{{fas "folder"}}</div>
<div>
  {{#if flowName}}<div class="u-text--overflow-two-lines worklist-list__overline">{{ flowName }}&#8203;</div>{{/if}}
  <span class="u-text--overflow-two-lines">{{ name }}&#8203;</span>
</div>
<div class="table-list__meta">
  <span><span data-state-region></span>&#8203;<span class="worklist-list__search-helper">{{ state }}</span>&#8203;</span>
  <span><span data-owner-region></span>&#8203;<span class="worklist-list__search-helper">{{ owner }}</span>&#8203;</span>
  <progress class="progress-bar worklist-list__flow-progress" value={{ _progress.complete }} max={{ _progress.total }}></progress>&#8203;
</div>
<div class="worklist-list__action-ts">
  <div class="worklist-list__overline">{{formatDateTime created_at "TIME_OR_DAY"}}&#8203;</div>
  <div>{{formatDateTime updated_at "TIME_OR_DAY"}}&#8203;</div>
</div>
