<div class="work-card__title-row">
  <button class="patient-list__patient patient-list__patient--primary worklist-list__patient worklist-list__patient--action js-patient" type="button" aria-expanded="false" aria-controls="worklist-list-sidebar">{{ patient.first_name }} {{ patient.last_name }}</button>
  <span class="work-card__separator">·</span>
  <button class="work-card__title js-primary" type="button">{{ name }}&#8203;</button>
  <span class="action-card__tool worklist-list__action-tool js-no-click"><span data-details-region></span></span>
  <span class="action-card__tool worklist-list__action-tool js-no-click"><span data-form-region></span></span>
</div>
{{#if flowName}}
<div class="work-card__context">
  <span class="worklist-list__patient-context worklist-list__patient-context--action">
    <button class="worklist-list__flow-context js-flow" type="button">{{ flowName }}</button>{{#if patient.segment}} · {{/if}}{{#if patient.segment}}<span class="worklist-list__underline">{{ patient.segment }}</span>{{/if}}&#8203;
  </span>
</div>
{{else}}{{#if patient.segment}}
<div class="work-card__context">
  <span class="worklist-list__patient-context worklist-list__patient-context--action"><span class="worklist-list__underline">{{ patient.segment }}</span>&#8203;</span>
</div>
{{/if}}{{/if}}
