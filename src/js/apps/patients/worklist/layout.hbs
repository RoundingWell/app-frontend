<div class="list-page__main">
  <div class="list-page__header">
    <div class="list-page__header-top">
      <div class="list-page__title">
        <div data-title-region></div>
      </div>
      <div class="list-page__topbar">
        <div class="patient-list-page__date-filter" data-date-filter-region></div>
        <div class="patient-list-page__find-controls">
          <div class="list-page__search patient-list-page__find-search" data-search-region></div>
          <div class="patient-list-page__filter-controls" data-filters-region></div>
        </div>
      </div>
    </div>
    <div data-selection-bar-region></div>
  </div>
  <div class="list-page__status" data-list-status-region></div>
  <div data-list-region></div>
</div>
<div class="patient-list-page__sidebar js-filters-sidebar" id="worklist-list-sidebar">
  <button class="button button--icon patient-list-page__drawer-close js-close-sidebar-drawer" type="button" aria-label="{{ @intl.patients.worklist.worklistViews.layoutView.closeSidebar }}">{{far "xmark"}}</button>
  <div class="patient-list-page__sidebar-content" data-filters-sidebar-region></div>
</div>
