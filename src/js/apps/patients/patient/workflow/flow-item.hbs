<div class="work-card__surface">
  <div class="work-card__main">
    <div class="work-card__heading">
      <span class="work-card__state patient-list__state js-no-click" data-state-region></span>
      <button class="work-card__title flow-card__title js-primary" type="button">{{far "folder-open"}}{{ name }}</button>
    </div>
  </div>
  <div class="work-card__aside">
    <div class="work-card__controls flow-card__controls">
      <span class="work-card__control flow-card__owner js-no-click" data-owner-region></span>
      <span class="work-card__control flow-card__status patient-list__flow-progress">
        <progress class="progress-bar patient__flow-progress" value="{{ _progress.complete }}" max="{{ _progress.total }}" aria-label="{{ _progress.complete }} / {{formatMessage (intlGet "patients.shared.listViews.countView.actionsCount") itemCount=_progress.total}}"></progress>
        <span class="patient-list__flow-progress-label">{{ _progress.complete }} / {{formatMessage (intlGet "patients.shared.listViews.countView.actionsCount") itemCount=_progress.total}}</span>
      </span>
    </div>
    <div class="work-card__meta">
      <span class="work-card__timestamps">
        <span>{{ @intl.patients.worklist.actionViews.added }} {{formatDateTime created_at "TIME_OR_DAY"}}</span>
        <span>{{ @intl.patients.worklist.actionViews.updated }} {{formatDateTime updated_at "TIME_OR_DAY"}}</span>
      </span>
    </div>
  </div>
</div>
