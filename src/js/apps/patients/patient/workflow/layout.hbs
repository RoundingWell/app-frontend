<div class="patient__tabs">
  <span class="patient__tab--selected">
    {{~ @intl.patients.patient.workflow.workflowViews.dashboardBtn ~}}
  </span>
  <button class="patient__tab js-archive">
    {{~ @intl.patients.patient.workflow.workflowViews.archiveBtn ~}}
  </button>
</div>
<div class="patient__actions-container">
  <div class="patient__actions" data-add-workflow-region>
    <span class="button-primary">
      <span class="js-loading">
        {{far "circle-plus"}}
        <span>{{ @intl.patients.patient.workflow.workflowViews.actionLoading }}</span>
      </span>
    </span>
  </div>
</div>
<div class="table-list patient__table-list">
  <div class="table-list__header list-page__list-header"></div>
  <div class="table-list__list list-page__list" data-content-region></div>
</div>
