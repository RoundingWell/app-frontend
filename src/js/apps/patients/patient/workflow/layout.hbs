<div class="workflow-page">
  <div class="workflow-page__toolbar">
    <div class="workflow-page__tabs" role="group" aria-label="{{ @intl.patients.patient.workflow.workflowViews.tabsLabel }}">
      <button class="workflow-page__tab is-selected js-dashboard" type="button" aria-pressed="true">
        {{~ @intl.patients.patient.workflow.workflowViews.dashboardBtn ~}}
      </button>
      <button class="workflow-page__tab js-archive" type="button" aria-pressed="false">
        {{~ @intl.patients.patient.workflow.workflowViews.archiveBtn ~}}
      </button>
    </div>
    <div class="workflow-page__actions" data-add-workflow-region>
      <span class="button button--outline button--pill add-workflow__button js-loading">
        {{far "circle-plus"}}
        <span>{{ @intl.patients.patient.workflow.workflowViews.actionLoading }}</span>
      </span>
    </div>
  </div>
  <div data-content-region></div>
</div>
