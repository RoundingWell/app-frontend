<div class="workflow-page">
  <div class="workflow-page__toolbar">
    <div class="workflow-page__tabs" role="group" aria-label="{{ @intl.patients.patient.workflow.workflowViews.tabsLabel }}">
      <button class="workflow-page__tab js-workflow-open" type="button" aria-pressed="false">
        {{~ @intl.patients.patient.workflow.workflowViews.openBtn ~}}
      </button>
      <button class="workflow-page__tab is-selected js-workflow-closed" type="button" aria-pressed="true">
        {{~ @intl.patients.patient.workflow.workflowViews.closedBtn ~}}
      </button>
    </div>
  </div>
  <div data-content-region></div>
</div>
