<span class="loader__text">{{ @intl.regions.preload.loading }}</span>
<div class="patient-action-loading__skeleton skeleton-loading">
  <header class="patient-action-loading__header" aria-hidden="true">
    <span class="skeleton-loading__shape patient-action-loading__title"></span>
    <div class="patient-action-loading__chips">
      <span class="skeleton-loading__shape patient-action-loading__chip patient-action-loading__chip--state"></span>
      <span class="skeleton-loading__shape patient-action-loading__chip"></span>
      <span class="skeleton-loading__shape patient-action-loading__chip patient-action-loading__chip--date"></span>
      <span class="skeleton-loading__shape patient-action-loading__chip patient-action-loading__chip--duration"></span>
    </div>
  </header>
  <section class="patient-action-loading__activity" aria-hidden="true">
    <span class="skeleton-loading__shape patient-action-loading__activity-heading"></span>
    <div class="patient-action-loading__activity-items">
      <span class="skeleton-loading__shape patient-action-loading__activity-item"></span>
      <span class="skeleton-loading__shape patient-action-loading__activity-item patient-action-loading__activity-item--short"></span>
    </div>
  </section>
</div>
