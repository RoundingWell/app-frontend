<div class="whats-new-guide">
  <p class="whats-new-guide__intro">{{ @intl.globals.appNav.appNavViews.whatsNew.guide.intro }}</p>

  <section class="whats-new-guide__section">
    <h3>{{ @intl.globals.appNav.appNavViews.whatsNew.guide.filtersHeading }}</h3>
    <p>{{ @intl.globals.appNav.appNavViews.whatsNew.guide.filtersDescription }}</p>
    <figure class="whats-new-guide__figure">
      <img src="/images/whats-new/worklist.webp" alt="{{ @intl.globals.appNav.appNavViews.whatsNew.guide.filtersImageAlt }}">
      <span class="whats-new-guide__highlight whats-new-guide__highlight--nav">
        <span>{{ @intl.globals.appNav.appNavViews.whatsNew.guide.navImageLabel }}</span>
      </span>
      <span class="whats-new-guide__highlight whats-new-guide__highlight--filters">
        <span>{{ @intl.globals.appNav.appNavViews.whatsNew.guide.filtersImageLabel }}</span>
      </span>
    </figure>
  </section>

  <section class="whats-new-guide__section">
    <h3>{{ @intl.globals.appNav.appNavViews.whatsNew.guide.actionHeading }}</h3>
    <p>{{ @intl.globals.appNav.appNavViews.whatsNew.guide.actionDescription }}</p>
    <figure class="whats-new-guide__figure">
      <img src="/images/whats-new/action.webp" alt="{{ @intl.globals.appNav.appNavViews.whatsNew.guide.actionImageAlt }}">
      <span class="whats-new-guide__highlight whats-new-guide__highlight--action">
        <span>{{ @intl.globals.appNav.appNavViews.whatsNew.guide.actionImageLabel }}</span>
      </span>
    </figure>
  </section>

  <section class="whats-new-guide__section whats-new-guide__moved">
    <h3>{{ @intl.globals.appNav.appNavViews.whatsNew.guide.movedHeading }}</h3>
    <dl>
      <div>
        <dt>{{ @intl.globals.appNav.appNavViews.whatsNew.guide.movedNavLabel }}</dt>
        <dd>{{ @intl.globals.appNav.appNavViews.whatsNew.guide.movedNavDescription }}</dd>
      </div>
      <div>
        <dt>{{ @intl.globals.appNav.appNavViews.whatsNew.guide.movedPatientLabel }}</dt>
        <dd>{{ @intl.globals.appNav.appNavViews.whatsNew.guide.movedPatientDescription }}</dd>
      </div>
      <div>
        <dt>{{ @intl.globals.appNav.appNavViews.whatsNew.guide.movedSupportLabel }}</dt>
        <dd>{{ @intl.globals.appNav.appNavViews.whatsNew.guide.movedSupportDescription }}</dd>
      </div>
    </dl>
  </section>
</div>
