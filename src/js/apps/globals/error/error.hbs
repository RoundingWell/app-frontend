<div class="error-page__content" role="alert">
  <img class="error-page__mark" src="/rwell-logo.svg" alt="">
  <h1 class="error-page__heading" id="global-error-title">{{ @intl.globals.error.errorTemplate.errorHeader }}</h1>

  <div class="error-page__message">
    {{#if is404}}
      <p>{{ @intl.globals.error.errorTemplate.notFoundMessage }}</p>
      <p>{{ @intl.globals.error.errorTemplate.notFoundInfo }}</p>
    {{/if}}
    {{#if status}}
      <p>{{ @intl.globals.error.errorTemplate.errorMessage }}</p>
      <p>{{formatMessage (intlGet "globals.error.errorTemplate.errorInfo") status=status}}</p>
    {{/if}}
  </div>

  <button class="error-page__recovery js-back button button--primary" type="button">{{ @intl.globals.error.errorTemplate.backBtn }}</button>
</div>
