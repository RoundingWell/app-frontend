<div class="error-page__content">
  <div class="error-page__title">
    <span class="error-page__icon" aria-hidden="true">
      {{#if is404}}{{far "triangle-exclamation" classes="error-page__status-icon error-page__status-icon--not-found"}}{{else}}{{far "octagon-exclamation" classes="error-page__status-icon"}}{{/if}}
    </span>
    <h2 class="error-page__heading">{{ @intl.globals.error.errorTemplate.errorHeader }}</h2>
  </div>
  <p class="error-page__message">
    {{#if is404}}
      {{ @intl.globals.error.errorTemplate.notFoundInfo }}<br>
      {{ @intl.globals.error.errorTemplate.notFoundHelp }}
    {{/if}}
    {{#if status}}
      {{ @intl.globals.error.errorTemplate.errorMessage }}<br>
      {{formatMessage (intlGet "globals.error.errorTemplate.errorInfo") status=status}}
    {{/if}}
  </p>
  <div class="error-page__actions">
    <button class="error-page__action js-back button" type="button">{{ @intl.globals.error.errorTemplate.backBtn }}</button>
  </div>
  <img class="error-page__brand" src="/images/roundingwell-logo.svg" alt="RoundingWell" width="120" height="18">
</div>
