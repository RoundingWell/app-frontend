<div class="patient-search__header">
  <button class="button button--icon patient-search__close patient-search__close--mobile js-search-back" type="button" aria-label="{{ @intl.globals.search.patientSearchViews.dialogView.backText }}">{{fas "arrow-left"}}</button>
  {{far "magnifying-glass" classes="patient-search__header-icon"}}
  <input class="js-input patient-search__input" type="search" value="{{ search }}" placeholder="{{ @intl.globals.search.patientSearchViews.dialogView.placeholderText }}" aria-label="{{ @intl.globals.search.patientSearchViews.dialogView.placeholderText }}" autocomplete="off" enterkeyhint="search" spellcheck="false">
  <button class="button button--icon patient-search__clear js-clear" type="button" aria-label="{{ @intl.globals.search.patientSearchViews.dialogView.clearText }}"{{#unless search}} hidden{{/unless}}>{{far "xmark"}}</button>
</div>
<div class="flex-region picklist__scroll js-picklist-scroll">
  <div data-header-region></div>
  <div data-list-region></div>
</div>
