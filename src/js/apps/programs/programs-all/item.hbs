<a class="card-list__item-surface js-program-link" href="{{ url }}">
  <div class="card-list__item-main">
    <h2 class="card-list__item-title" data-testid="program-list-name">{{ name }}</h2>
    {{far "chevron-right"}}
  </div>
  {{#if details}}<p class="programs-list__details">{{ details }}</p>{{/if}}
  <div class="card-list__item-meta">
    <span class="programs-list__published">{{ @intl.programs.report.publishedText }}</span>
    {{#if updated_at}}<span>{{ @intl.programs.report.updatedLabel }} {{formatDateTime updated_at "MMM D, YYYY"}}</span>{{/if}}
  </div>
</a>
