<div>
  <span class="table-list__icon--large workflows__action-icon">{{far icon}}</span>
  <span>
    {{ name }}
    {{~#unless name}}<em>{{ @intl.programs.program.workflows.actionItemTemplate.newProgramAction }}</em>{{/unless~}}
  </span>
</div>
<div class="table-list__meta">
  <span data-behavior-region></span>
  <span data-owner-region></span>
  <span data-due-region></span>
  <span>
    {{#if hasForm}}
      <button class="button-secondary--compact" disabled>{{far "square-poll-horizontal"}}</button>
    {{/if }}
  </span>
</div>
<div class="workflows__item-ts">{{formatDateTime updated_at "TIME_OR_DAY"}}</div>
