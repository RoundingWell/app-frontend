<div>
  <span class="table-list__icon--large workflows__action-icon">{{far icon}}</span>{{~ remove_whitespace ~}}
  <span>
    {{ name }}{{~ remove_whitespace ~}}
    {{~#unless name}}<em>{{ @intl.programs.program.workflows.actionItemTemplate.newProgramAction }}</em>{{/unless~}}
  </span>
</div>
<div class="table-list__meta">
  <span data-behavior-region></span>{{~ remove_whitespace ~}}
  <span data-owner-region></span>{{~ remove_whitespace ~}}
  <span data-due-region></span>{{~ remove_whitespace ~}}
  <span>
    {{#if hasForm}}
      <button class="button-secondary--compact" disabled>{{far "square-poll-horizontal"}}</button>
    {{/if }}
  </span>{{~ remove_whitespace ~}}
</div>
<div class="workflows__item-ts">{{formatDateTime updated_at "TIME_OR_DAY"}}</div>
