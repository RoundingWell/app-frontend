<div>
  <span class="table-list__icon--large workflows__flow-icon">{{fas "folder"}}</span>{{~ remove_whitespace ~}}
  <span>
    {{ name }}{{~ remove_whitespace ~}}
    {{~#unless name}}<em>{{ @intl.programs.program.workflows.flowItemTemplate.newProgramFlow }}</em>{{/unless~}}
  </span>
</div>
<div class="table-list__meta">
  <span class="workflows__flow-status">
    {{#if published}}
      {{#if isAutomated}}
        <span class="workflows-action--automated">{{far "bolt"}}</span>
      {{ else }}
        <span class="workflows-action--published">{{far "circle-play"}}</span>
      {{/if}}
    {{ else }}
      <span class="workflows-action--draft">{{far "pen-to-square"}}</span>
    {{/if}}
  </span>{{~ remove_whitespace ~}}
  <span data-owner-region></span>{{~ remove_whitespace ~}}
</div>
<div class="workflows__item-ts">{{formatDateTime updated_at "TIME_OR_DAY"}}</div>
