<div class="table-list__icon--large program-flow__action-icon">
  {{#if options.icon}}
    <span class="action-icon--{{options.color}}">{{fa options.iconType options.icon}}</span>
  {{else}}
    {{far icon}}
  {{/if}}
</div>
<div class="u-text--overflow-two-lines">
  {{ name }}
  {{~#unless name}}<em>{{ @intl.programs.program.flow.actionItemTemplate.newProgramFlowAction }}</em>{{/unless~}}
</div>
<div class="table-list__meta">
  <span data-behavior-region></span>
  <span data-owner-region></span>
  <span data-due-region></span>
  <span>
    {{#if hasForm}}
      <button class="button-secondary--compact" disabled>{{far "square-poll-horizontal"}}</button>
    {{/if }}
  </span>
</div>
<div class="program-flow__action-ts">{{formatDateTime updated_at "TIME_OR_DAY"}}</div>
<div class="program-flow__sort-handle js-sort">{{fas "grip-vertical"}}</div>
