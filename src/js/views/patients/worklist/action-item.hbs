<div class="table-list__item-check js-no-click"><span data-check-region></span></div>
<div>
  <button class="button-secondary--compact js-patient-sidebar-button">
    {{far "address-card"}}&#8203;
  </button>
</div>
<div class="js-patient">
  {{#if patient.segment}}<div class="u-text--overflow-two-lines worklist-list__overline">{{ patient.segment }}&#8203;</div>{{/if}}{{~ remove_whitespace ~}}
  <span class="u-text--overflow-two-lines worklist-list__patient-name">{{ patient.first_name }} {{ patient.last_name }}&#8203;</span>{{~ remove_whitespace ~}}
</div>
<div class="worklist-list__action-icon">{{far icon}}</div>{{~ remove_whitespace ~}}
<div>
  {{#if flowName}}<div class="u-text--overflow-two-lines worklist-list__overline">{{ flowName }}&#8203;</div>{{/if}}{{~ remove_whitespace ~}}
  <span class="u-text--overflow-two-lines">{{ name }}&#8203;</span>{{~ remove_whitespace ~}}
</div>
<div class="table-list__meta">
  <span class="u-margin--r-8" data-details-region></span>{{~ remove_whitespace ~}}
  <span><span data-state-region></span><span class="worklist-list__search-helper">&#8203;{{ state }}&#8203;</span></span>{{~ remove_whitespace ~}}
  <span><span data-owner-region></span><span class="worklist-list__search-helper">&#8203;{{ owner }}&#8203;</span></span>{{~ remove_whitespace ~}}
  <span><span data-due-date-region></span><span data-due-time-region></span></span>{{~ remove_whitespace ~}}
  <span><span data-form-region></span>{{~ remove_whitespace ~}}&#8203;</span>
  {{#if hasAttachments}}
    <span class="u-margin--l-8">{{far "paperclip"}}</span>{{~ remove_whitespace ~}}
  {{/if}}
  {{#if commentCount}}
    <span class="u-margin--l-8">{{far "comment"}}<span class="u-margin--l-8 u-margin--r-8">{{commentCount}}</span></span>{{~ remove_whitespace ~}}
  {{/if}}
</div>
<div class="worklist-list__action-ts">
  <div class="worklist-list__overline">{{formatDateTime created_at "TIME_OR_DAY"}}&#8203;</div>
  <div>{{formatDateTime updated_at "TIME_OR_DAY"}}&#8203;</div>
</div>

