<div class="error-page__content">
  <div class="error-page__title">
    <span class="error-page__icon" aria-hidden="true">
      {{far "circle-exclamation" classes="error-page__status-icon"}}
    </span>
    <h2 class="error-page__heading">Hold up,</h2>
  </div>
  <p class="error-page__message">
    Your account is not set up yet.<br>
    Please notify your manager or administrator to correct this issue.
  </p>
  <img class="error-page__brand" src="/images/roundingwell-logo.svg" alt="RoundingWell" width="120" height="18">
</div>
